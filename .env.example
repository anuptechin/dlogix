# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=lprms
POSTGRES_PASSWORD=lprms_dev_pw
POSTGRES_DB=lprms
DATABASE_URL=postgresql://lprms:lprms_dev_pw@db:5432/lprms?schema=public

# ─── Redis (job queue) ──────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── API ────────────────────────────────────────────────────
API_PORT=3093
NODE_ENV=development
# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:5103

# ─── Web ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3093

# ─── Microsoft 365 / Entra ID (leave blank to disable SSO in dev) ─
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# When SSO is disabled, a dev login endpoint issues tokens for seeded users
AUTH_DEV_MODE=true

# ─── Email ──────────────────────────────────────────────────
# console = log emails to stdout (no external send). graph = Microsoft Graph. smtp = relay.
EMAIL_TRANSPORT=console
EMAIL_FROM=tuesday@ddecor.com
# ─── OTP email via Office365 SMTP (set EMAIL_TRANSPORT=smtp to send) ───
COLORWAY_SMTP_HOST=smtp.office365.com
COLORWAY_SMTP_PORT=587
COLORWAY_SMTP_USER=tuesday@ddecor.com
COLORWAY_SMTP_PASS=

# ─── Tokens ─────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
VENDOR_TOKEN_GRACE_HOURS=48

# ─── Session cookie signing secret (REQUIRED in production, >=16 chars) ───
SESSION_SECRET=change-me-to-a-long-random-string
