# ─── Dlogix production env — copy to .env.production and fill in ───
# NEVER commit .env.production (it's gitignored).

NODE_ENV=production

# Docker network that the SHARED Postgres + SHARED nginx are on.
#   docker network ls    (pick the one your shared PG/nginx use)
SHARED_NETWORK=CHANGE_ME_shared_network

# Shared Postgres — create a DB + user for Dlogix on the shared instance, then:
#   DATABASE_URL=postgresql://<user>:<pass>@<shared-pg-service>:5432/<db>?schema=public
# <shared-pg-service> is the shared Postgres container name/DNS on SHARED_NETWORK.
DATABASE_URL=postgresql://dlogix:CHANGE_ME@shared-postgres:5432/dlogix?schema=public

API_PORT=3093

# Public origin (shared nginx serves this with the wildcard cert).
CORS_ORIGIN=https://dlogix.ddecor.com
WEB_BASE_URL=https://dlogix.ddecor.com

# Session cookie signing secret — REQUIRED, use a long random string:
#   openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_long_random_hex

# ─── OTP email via Office365 SMTP ───
EMAIL_TRANSPORT=smtp
EMAIL_FROM=tuesday@ddecor.com
COLORWAY_SMTP_HOST=smtp.office365.com
COLORWAY_SMTP_PORT=587
COLORWAY_SMTP_USER=tuesday@ddecor.com
COLORWAY_SMTP_PASS=CHANGE_ME

# Vendor quote link grace window
VENDOR_TOKEN_GRACE_HOURS=48
