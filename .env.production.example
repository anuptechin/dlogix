# ─── Dlogix production env — copy to .env.production and fill in ───
# NEVER commit .env.production (it's gitignored).

NODE_ENV=production

# Docker network the shared Postgres container is on (dlogix-api joins it).
#   docker inspect <pg-container> -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
DB_NETWORK=CHANGE_ME_db_network          # e.g. crmuat_ddecor_internal

# Docker network the shared nginx (nginx_proxy) is on (dlogix-web joins it, so
# the proxy can reach it by container name).
#   docker inspect nginx_proxy -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=CHANGE_ME_proxy_network    # e.g. shared_proxy

# Shared Postgres — create a DB + user for Dlogix on the shared instance, then:
#   DATABASE_URL=postgresql://<user>:<pass>@<pg-container-name>:5432/<db>?schema=public
# <pg-container-name> is the Postgres container's name/DNS on DB_NETWORK.
DATABASE_URL=postgresql://dlogix:CHANGE_ME@ddecor_db:5432/dlogix?schema=public

API_PORT=3093

# Public origin (shared nginx serves this with the wildcard cert).
CORS_ORIGIN=https://dlogix.ddecor.com
WEB_BASE_URL=https://dlogix.ddecor.com

# Session cookie signing secret — REQUIRED, use a long random string:
#   openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_long_random_hex

# ─── OTP email via Office365 SMTP ───
EMAIL_TRANSPORT=smtp
EMAIL_FROM=tuesday@ddecor.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=tuesday@ddecor.com
SMTP_PASS=CHANGE_ME

# Vendor quote link grace window
VENDOR_TOKEN_GRACE_HOURS=48
