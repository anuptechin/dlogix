// LPRMS Phase 1 schema — see LPRMS_Phase1_Detailed_Plan.md §3
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LOGISTICS
  DOCUMENTATION
  MANAGEMENT
  ADMIN
}

enum ShipmentDirection {
  EXPORT
  IMPORT
}

enum ShipmentMode {
  AIR
  LCL
  FCL
  COURIER
}

enum EnquiryStatus {
  DRAFT
  SENT
  QUOTING
  COMPARED
  AWARDED
  CLOSED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  DRAFT
  SUBMITTED
  WITHDRAWN
}

enum EnquiryVendorStatus {
  INVITED
  OPENED
  RESPONDED
  DECLINED
}

enum FeedbackType {
  WON
  LOST
  GENERIC
}

model User {
  id            String    @id @default(uuid())
  entraObjectId String?   @unique @map("entra_object_id")
  name          String
  email         String    @unique
  role          UserRole  @default(LOGISTICS)
  passwordHash  String?   @map("password_hash")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  enquiries Enquiry[]
  awards    Award[]

  @@map("users")
}

model Vendor {
  id               String         @id @default(uuid())
  name             String
  contactPerson    String?        @map("contact_person")
  email            String
  phone            String?
  address          String?
  modeCapabilities ShipmentMode[] @map("mode_capabilities")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")

  enquiryVendors   EnquiryVendor[]
  shipmentHistory  ShipmentHistory[]
  courierContracts CourierContract[]
  groupMemberships VendorGroupMember[]

  @@map("vendors")
}

model PortLocation {
  id      String  @id @default(uuid())
  kind    String // PORT | AIRPORT | CITY
  code    String?
  name    String
  country String?

  enquiryOrigins       Enquiry[] @relation("EnquiryOrigin")
  enquiryDestinations  Enquiry[] @relation("EnquiryDestination")
  enquiryIcdCfs        Enquiry[] @relation("EnquiryOriginIcdCfs")

  @@map("ports_locations")
}

enum ChargeCategory {
  FREIGHT
  ORIGIN
  DESTINATION
  LOCAL
  OTHER
}

model ChargeType {
  id            String         @id @default(uuid())
  name          String
  unit          String?
  category      ChargeCategory @default(OTHER) // buckets the landed-cost breakdown
  appliesToMode ShipmentMode[] @map("applies_to_mode")
  isActive      Boolean        @default(true) @map("is_active")

  lines          QuotationLine[]
  requiredCharges EnquiryRequiredCharge[]

  @@map("charge_types")
}

enum ShipmentPriority {
  NORMAL
  URGENT
}

model Enquiry {
  id               String            @id @default(uuid())
  enquiryNo        String            @unique @map("enquiry_no")
  direction        ShipmentDirection
  mode             ShipmentMode
  originId         String?           @map("origin_id")
  destinationId    String?           @map("destination_id")
  cargoDesc        String?           @map("cargo_desc")
  weightKg         Decimal?          @map("weight_kg") @db.Decimal(12, 3)
  volumeCbm        Decimal?          @map("volume_cbm") @db.Decimal(12, 3)
  chargeableWeight Decimal?          @map("chargeable_weight") @db.Decimal(12, 3)
  incoterm         String?
  targetDate       DateTime?         @map("target_date") @db.Date
  quoteDeadline    DateTime?         @map("quote_deadline")
  status           EnquiryStatus     @default(DRAFT)
  createdById      String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  // ── BRD: parties (export uses customer/consignee, import uses supplier/buyer) ──
  businessUnit      String?  @map("business_unit")
  branchPlant       String?  @map("branch_plant")
  customerId        String?  @map("customer_id")
  consigneeId       String?  @map("consignee_id")
  supplierId        String?  @map("supplier_id")
  buyerId           String?  @map("buyer_id")
  salesOrderNo      String?  @map("sales_order_no")
  customerPoNo      String?  @map("customer_po_no")
  supplierInvoiceNo String?  @map("supplier_invoice_no")
  poNumbers         String[] @map("po_numbers")

  // ── BRD: cargo ──
  commodity        String?
  hsCode           String?           @map("hs_code")
  natureOfCargo    String?           @map("nature_of_cargo")
  packageType      String?           @map("package_type")
  packageCount     Int?              @map("package_count")
  netWeightKg      Decimal?          @map("net_weight_kg") @db.Decimal(12, 3)
  volumetricWeight Decimal?          @map("volumetric_weight") @db.Decimal(12, 3)
  cargoValue       Decimal?          @map("cargo_value") @db.Decimal(14, 2)
  cargoCurrency    String?           @map("cargo_currency")
  priority         ShipmentPriority?

  // ── BRD: origin / destination detail ──
  originIcdCfsId  String?  @map("origin_icd_cfs_id")
  pickupAddress   String?  @map("pickup_address")
  deliveryAddress String?  @map("delivery_address")
  finalDestination String? @map("final_destination")
  stuffingLocation String? @map("stuffing_location")
  factoryStuffing  Boolean? @map("factory_stuffing")

  // ── BRD: service scope + checkbox flags (JSON: many differ per mode) ──
  serviceScope   String?  @map("service_scope")
  serviceOptions Json?    @map("service_options")

  // ── BRD: shipping requirements ──
  preferredShippingLine String?   @map("preferred_shipping_line")
  preferredVessel       String?   @map("preferred_vessel")
  directServiceOnly     Boolean?  @map("direct_service_only")
  transshipmentAllowed  Boolean?  @map("transshipment_allowed")
  maxTransitDays        Int?      @map("max_transit_days")
  etdRequired           DateTime? @map("etd_required") @db.Date
  etaRequired           DateTime? @map("eta_required") @db.Date

  // ── BRD: quote submission ──
  quoteValidityDate    DateTime? @map("quote_validity_date") @db.Date
  sailingRequiredBefore DateTime? @map("sailing_required_before") @db.Date

  // ── BRD: incoterm-specific captured fields + remarks ──
  incotermDetails     Json?   @map("incoterm_details")
  specialInstructions String? @map("special_instructions")
  internalRemarks     String? @map("internal_remarks")

  createdBy       User              @relation(fields: [createdById], references: [id])
  origin          PortLocation?     @relation("EnquiryOrigin", fields: [originId], references: [id])
  destination     PortLocation?     @relation("EnquiryDestination", fields: [destinationId], references: [id])
  originIcdCfs    PortLocation?     @relation("EnquiryOriginIcdCfs", fields: [originIcdCfsId], references: [id])
  customer        Party?            @relation("EnquiryCustomer", fields: [customerId], references: [id])
  consignee       Party?            @relation("EnquiryConsignee", fields: [consigneeId], references: [id])
  supplier        Party?            @relation("EnquirySupplier", fields: [supplierId], references: [id])
  buyer           Party?            @relation("EnquiryBuyer", fields: [buyerId], references: [id])
  dimensions      EnquiryDimension[]
  containers      EnquiryContainer[]
  requiredCharges EnquiryRequiredCharge[]
  documents       EnquiryDocument[]
  enquiryVendors  EnquiryVendor[]
  award           Award?
  shipmentHistory ShipmentHistory[]

  @@map("enquiries")
}

model EnquiryVendor {
  id             String              @id @default(uuid())
  enquiryId      String              @map("enquiry_id")
  vendorId       String              @map("vendor_id")
  inviteToken    String              @unique @map("invite_token")
  tokenExpiresAt DateTime            @map("token_expires_at")
  status         EnquiryVendorStatus @default(INVITED)
  invitedAt      DateTime            @default(now()) @map("invited_at")
  respondedAt    DateTime?           @map("responded_at")

  enquiry   Enquiry          @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  vendor    Vendor           @relation(fields: [vendorId], references: [id])
  quotation Quotation?
  feedback  VendorFeedback[]

  @@unique([enquiryId, vendorId])
  @@map("enquiry_vendors")
}

enum RateType {
  SPOT
  CONTRACT
}

model Quotation {
  id              String      @id @default(uuid())
  enquiryVendorId String      @unique @map("enquiry_vendor_id")
  currency        String      @default("INR")
  validUntil      DateTime?   @map("valid_until") @db.Date
  transitTimeDays Int?        @map("transit_time_days")
  remarks         String?
  totalAmount     Decimal     @default(0) @map("total_amount") @db.Decimal(14, 2)
  status          QuoteStatus @default(PENDING)
  submittedAt     DateTime?   @map("submitted_at")

  // ── BRD "features wished for": free days, sailing schedule, rate type ──
  rateType              RateType? @map("rate_type")
  freeDetentionOriginDays Int?    @map("free_detention_origin_days")
  freeDetentionDestDays   Int?    @map("free_detention_dest_days")
  freeDemurrageDestDays   Int?    @map("free_demurrage_dest_days")
  etd            DateTime? @db.Date
  eta            DateTime? @db.Date
  transshipments Int?
  shippingLine   String?   @map("shipping_line")
  vesselName     String?   @map("vessel_name")

  enquiryVendor EnquiryVendor   @relation(fields: [enquiryVendorId], references: [id], onDelete: Cascade)
  lines         QuotationLine[]
  awards        Award[]

  @@map("quotations")
}

model QuotationLine {
  id           String  @id @default(uuid())
  quotationId  String  @map("quotation_id")
  chargeTypeId String? @map("charge_type_id")
  description  String?
  unit         String?
  qty          Decimal @default(1) @db.Decimal(12, 3)
  rate         Decimal @default(0) @db.Decimal(14, 4)
  amount       Decimal @default(0) @db.Decimal(14, 2)

  quotation  Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  chargeType ChargeType? @relation(fields: [chargeTypeId], references: [id])

  @@map("quotation_lines")
}

model Award {
  id            String   @id @default(uuid())
  enquiryId     String   @unique @map("enquiry_id")
  quotationId   String   @map("quotation_id")
  awardedById   String   @map("awarded_by")
  awardedAmount Decimal  @map("awarded_amount") @db.Decimal(14, 2)
  reason        String?
  awardedAt     DateTime @default(now()) @map("awarded_at")

  enquiry   Enquiry   @relation(fields: [enquiryId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])
  awardedBy User      @relation(fields: [awardedById], references: [id])

  @@map("awards")
}

model VendorFeedback {
  id              String       @id @default(uuid())
  enquiryVendorId String       @map("enquiry_vendor_id")
  feedbackType    FeedbackType @map("feedback_type")
  message         String?
  sentAt          DateTime?    @map("sent_at")

  enquiryVendor EnquiryVendor @relation(fields: [enquiryVendorId], references: [id])

  @@map("vendor_feedback")
}

model ShipmentHistory {
  id            String             @id @default(uuid())
  enquiryId     String?            @map("enquiry_id")
  direction     ShipmentDirection?
  mode          ShipmentMode?
  originId      String?            @map("origin_id")
  destinationId String?            @map("destination_id")
  vendorId      String?            @map("vendor_id")
  amount        Decimal?           @db.Decimal(14, 2)
  currency      String?
  awardedAt     DateTime?          @map("awarded_at")

  enquiry Enquiry? @relation(fields: [enquiryId], references: [id])
  vendor  Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([direction, mode, originId, destinationId])
  @@map("shipment_history")
}

model AuditLog {
  id       String   @id @default(uuid())
  actorId  String?  @map("actor_id")
  action   String
  entity   String
  entityId String?  @map("entity_id")
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@map("audit_log")
}

// ─── Phase 2: Courier rate management ──────────────────────────

enum CourierSurchargeType {
  FUEL_PCT
  REMOTE_AREA
  OTHER
}

model CourierContract {
  id          String            @id @default(uuid())
  vendorId    String            @map("vendor_id")
  serviceName String            @map("service_name")
  direction   ShipmentDirection
  currency    String            @default("INR")
  validFrom   DateTime?         @map("valid_from") @db.Date
  validTo     DateTime?         @map("valid_to") @db.Date
  isActive    Boolean           @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  vendor     Vendor             @relation(fields: [vendorId], references: [id])
  slabs      CourierRateSlab[]
  surcharges CourierSurcharge[]
  transits   CourierTransit[]

  @@map("courier_contracts")
}

model CourierRateSlab {
  id              String   @id @default(uuid())
  contractId      String   @map("contract_id")
  destinationZone String   @map("destination_zone")
  weightFromKg    Decimal  @map("weight_from_kg") @db.Decimal(12, 3)
  weightToKg      Decimal  @map("weight_to_kg") @db.Decimal(12, 3)
  ratePerKg       Decimal? @map("rate_per_kg") @db.Decimal(14, 4)
  flatRate        Decimal? @map("flat_rate") @db.Decimal(14, 2)
  minCharge       Decimal? @map("min_charge") @db.Decimal(14, 2)

  contract CourierContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, destinationZone])
  @@map("courier_rate_slabs")
}

model CourierSurcharge {
  id           String               @id @default(uuid())
  contractId   String               @map("contract_id")
  type         CourierSurchargeType
  label        String
  value        Decimal              @db.Decimal(14, 4)
  isPercentage Boolean              @default(false) @map("is_percentage")

  contract CourierContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("courier_surcharges")
}

model CourierTransit {
  id              String @id @default(uuid())
  contractId      String @map("contract_id")
  destinationZone String @map("destination_zone")
  transitDays     Int    @map("transit_days")

  contract CourierContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("courier_transit")
}

// ─── BRD: trading parties, groups, masters & enquiry children ───────────

enum PartyRole {
  CUSTOMER
  CONSIGNEE
  SUPPLIER
  BUYER
}

// Trading partners (customers/consignees for export, suppliers/buyers for import).
// Distinct from Vendor (the forwarders who quote).
model Party {
  id                 String      @id @default(uuid())
  name               String
  code               String?
  roles              PartyRole[]
  contactPerson      String?     @map("contact_person")
  email              String?
  phone              String?
  address            String?
  country            String?
  city               String?
  preferredAirportId String?     @map("preferred_airport_id")
  preferredPortId    String?     @map("preferred_port_id")
  preferredForwarderId String?   @map("preferred_forwarder_id")
  isActive           Boolean     @default(true) @map("is_active")
  createdAt          DateTime    @default(now()) @map("created_at")

  customerEnquiries  Enquiry[] @relation("EnquiryCustomer")
  consigneeEnquiries Enquiry[] @relation("EnquiryConsignee")
  supplierEnquiries  Enquiry[] @relation("EnquirySupplier")
  buyerEnquiries     Enquiry[] @relation("EnquiryBuyer")

  @@map("parties")
}

// Vendor groups by lane/region, e.g. "Europe Air", "USA FCL", "China Imports".
model VendorGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  members VendorGroupMember[]

  @@map("vendor_groups")
}

model VendorGroupMember {
  id       String @id @default(uuid())
  groupId  String @map("group_id")
  vendorId String @map("vendor_id")

  group  VendorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  vendor Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([groupId, vendorId])
  @@map("vendor_group_members")
}

// Generic reference master for simple dropdowns:
// COMMODITY, PACKAGE_TYPE, CONTAINER_TYPE, NATURE_OF_CARGO, SERVICE_SCOPE, BUSINESS_UNIT.
model LookupOption {
  id        String   @id @default(uuid())
  category  String
  code      String?
  label     String
  meta      Json?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  @@index([category])
  @@map("lookup_options")
}

// Incoterm master: drives the dynamic incoterm section + responsibility matrix.
model Incoterm {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  shownFields      Json?    @map("shown_fields")
  responsibilities Json?
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")

  @@map("incoterms")
}

// Cargo dimension rows (L×W×H×Qty) → volume / volumetric weight.
model EnquiryDimension {
  id        String  @id @default(uuid())
  enquiryId String  @map("enquiry_id")
  label     String?
  lengthCm  Decimal @map("length_cm") @db.Decimal(10, 2)
  widthCm   Decimal @map("width_cm") @db.Decimal(10, 2)
  heightCm  Decimal @map("height_cm") @db.Decimal(10, 2)
  qty       Int     @default(1)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@map("enquiry_dimensions")
}

// Container rows for FCL enquiries.
model EnquiryContainer {
  id            String   @id @default(uuid())
  enquiryId     String   @map("enquiry_id")
  containerType String   @map("container_type")
  qty           Int      @default(1)
  estWeightKg   Decimal? @map("est_weight_kg") @db.Decimal(12, 3)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@map("enquiry_containers")
}

// Which charge types the invited vendors must quote for this enquiry.
model EnquiryRequiredCharge {
  id           String @id @default(uuid())
  enquiryId    String @map("enquiry_id")
  chargeTypeId String @map("charge_type_id")

  enquiry    Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  chargeType ChargeType @relation(fields: [chargeTypeId], references: [id])

  @@unique([enquiryId, chargeTypeId])
  @@map("enquiry_required_charges")
}

// Uploaded supporting documents (invoice, packing list, VGM, etc.).
model EnquiryDocument {
  id           String   @id @default(uuid())
  enquiryId    String   @map("enquiry_id")
  docType      String?  @map("doc_type")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  uploadedById String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@map("enquiry_documents")
}

// ─── Export Courier Rate Cards (DHL / FedEx) — zone list + price matrix ───
// Distinct from the slab-based CourierContract model above; this mirrors the
// D'Decor courier rate workbook (zone lists + weight×zone price matrices).

enum CourierCarrier {
  DHL
  FEDEX
}

enum CourierFuelOrder {
  SURCHARGE_THEN_FUEL // DHL: (rate + surcharge) × (1 + fuel)
  FUEL_THEN_SURCHARGE // FedEx: rate × (1 + fuel) + surcharge
}

model CourierRateCard {
  id                 String         @id @default(uuid())
  carrier            CourierCarrier @unique
  currency           String         @default("INR")
  fuelOrder          CourierFuelOrder @default(SURCHARGE_THEN_FUEL) @map("fuel_order")
  // volumetric divisors (defined by courier): L×W×H ÷ divisor per piece
  volumetricDivisorCm Int           @default(5000) @map("volumetric_divisor_cm")
  volumetricDivisorIn Int           @default(139) @map("volumetric_divisor_in")
  // pricing chain (editable defaults, seeded from the sheet)
  flatMaxWeightKg    Decimal        @default(30) @map("flat_max_weight_kg") @db.Decimal(10, 2)
  surchargePerKg     Decimal        @default(150) @map("surcharge_per_kg") @db.Decimal(12, 4)
  fuelPct            Decimal        @default(0.30) @map("fuel_pct") @db.Decimal(6, 4)
  gstPct             Decimal        @default(0.18) @map("gst_pct") @db.Decimal(6, 4)
  marginX            Decimal        @default(2) @map("margin_x") @db.Decimal(6, 3)
  // currency rates (INR per 1 unit), defined by us — editable
  usdRate            Decimal        @default(53) @map("usd_rate") @db.Decimal(10, 4)
  gbpRate            Decimal        @default(70) @map("gbp_rate") @db.Decimal(10, 4)
  eurRate            Decimal        @default(60) @map("eur_rate") @db.Decimal(10, 4)
  updatedAt          DateTime       @updatedAt @map("updated_at")

  zones CourierZone[]
  rates CourierRateRow[]

  @@map("courier_rate_cards")
}

model CourierZone {
  id         String @id @default(uuid())
  rateCardId String @map("rate_card_id")
  country    String
  zone       String

  rateCard CourierRateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, country])
  @@index([rateCardId, country])
  @@map("courier_zones")
}

model CourierRateRow {
  id         String  @id @default(uuid())
  rateCardId String  @map("rate_card_id")
  weightKg   Decimal @map("weight_kg") @db.Decimal(12, 3)
  zone       String
  price      Decimal @db.Decimal(14, 4)
  perKg      Boolean @default(false) @map("per_kg") // true = price is per-kg (applies above flat range)

  rateCard CourierRateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, weightKg, zone])
  @@index([rateCardId, zone, weightKg])
  @@map("courier_rate_rows")
}

// One-time codes for email OTP login (interim until M365 SSO).
model LoginOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("login_otps")
}
