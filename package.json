{
  "name": "lprms",
  "version": "0.1.0",
  "private": true,
  "description": "Logistics Procurement & Rate Management System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @lprms/api\" \"npm run dev -w @lprms/web\"",
    "build": "npm run build -w @lprms/shared && npm run build -w @lprms/api && npm run build -w @lprms/web",
    "db:migrate": "npm run prisma:migrate -w @lprms/api",
    "db:seed": "npm run seed -w @lprms/api",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:up": "docker compose up --build -d",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
